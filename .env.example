# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -base64 48

# ── OperationKit core (required in production) ──────────────────────────────
# compose maps CC_JWT_SECRET → JWT_SECRET inside the container.
# Boot fails if this is missing, short, or a known placeholder.
CC_JWT_SECRET=

# Shared secret for localhost-only internal APIs (deploy, routines, test-creds).
# Required when NODE_ENV=production.
INTERNAL_API_SECRET=

# Optional. If set, POST /api/webhooks/uptimerobot requires ?token=… (or X-Webhook-Token).
UPTIMEROBOT_WEBHOOK_TOKEN=

# Optional. HMAC for POST /api/webhooks/github.
GITHUB_WEBHOOK_SECRET=

# Optional. Comma-separated. Defaults include https://cc.example.com and local Vite.
# CORS_ORIGINS=https://your-host.example,http://localhost:5173

# ── LiteLLM (optional sibling; omit if you are not running the proxy) ──
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=

# LLM provider keys (LiteLLM and optional direct calls)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# GPU droplet (future)
GPU_OLLAMA_URL=

# ── Host paths (optional; defaults match the DigitalOcean installer layout) ──
# The server reads project checkouts, agent definitions, and the knowledge vault
# from directories bind-mounted in docker-compose.yml. Override these only if you
# mounted them somewhere other than /home/operator/... on the host.
# Defaults live in app/server/src/config.ts.

# Where session git checkouts live. Default: /home/operator/projects
PROJECTS_DIR=

# Agent definitions, skills, and workspaces.json. Default: /home/operator/ai-workspace
AI_WORKSPACE_DIR=

# This repository's own checkout, used for self-deploy and drift checks.
# Default: ${PROJECTS_DIR}/operationkit
CC_REPO_DIR=

# ── Doppler (optional secrets manager) ───────────────────────────────────────
# Doppler is entirely optional — .env is the primary path. See docs/CREDENTIALS.md.

# Path to the Doppler admin service token read by the server.
# Default: ${PROJECTS_DIR}/.doppler-admin-token
DOPPLER_TOKEN_PATH=

# Feature flag. When "true", member sessions are spawned with per-user scoped
# Doppler tokens instead of the shared admin token. Leave unset/false unless you
# have provisioned scoped tokens. Default: false
USE_SCOPED_DOPPLER_TOKENS=

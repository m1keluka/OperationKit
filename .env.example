# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -base64 48

# ── Command Center (required in production) ──────────────────────────────
# compose maps CC_JWT_SECRET → JWT_SECRET inside the container.
# Boot fails if this is missing, short, or a known placeholder.
CC_JWT_SECRET=

# Shared secret for localhost-only internal APIs (deploy, routines, test-creds).
# Required when NODE_ENV=production.
INTERNAL_API_SECRET=

# Optional. If set, POST /api/webhooks/uptimerobot requires ?token=… (or X-Webhook-Token).
UPTIMEROBOT_WEBHOOK_TOKEN=

# Optional. HMAC for POST /api/webhooks/github.
GITHUB_WEBHOOK_SECRET=

# Optional. Comma-separated. Defaults include https://cc.example.com and local Vite.
# CORS_ORIGINS=https://your-host.example,http://localhost:5173

# ── LiteLLM (optional sibling; omit if you are not running the proxy) ──
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=

# LLM provider keys (LiteLLM and optional direct calls)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# GPU droplet (future)
GPU_OLLAMA_URL=

# ── Session isolation (OSS / client sample) ───────────────────────────────
# Per-session sibling Docker container sandbox. See
# docs (PRD §6.6) and app/server/src/services/session-jail.ts.
#
#   unset or `tmux`  → today's shared-container tmux spawn (no sandbox)
#   docker           → one `ok-jail-<objectiveId>` container per session:
#                      only that session's worktree (/workspace) and its own
#                      HOME (/home/jailuser) are mounted; no docker socket, no
#                      operator home. Fail-closed: if `docker run` fails the
#                      session fails — it never silently falls back to tmux.
#
# This is a DOCUMENTATION default for OSS/client installs only. There is
# deliberately no `docker` default in config.ts, and Mike's live box
# (cc.example.com) leaves SESSION_ISOLATION UNSET — it runs the tmux path.
SESSION_ISOLATION=docker

# Jail image. Build with:
#   docker build -t ok-jail:local -f app/jail/Dockerfile app/jail
# Pin by digest in production (ok-jail@sha256:…). No registry is assumed.
SESSION_JAIL_IMAGE=ok-jail:local
